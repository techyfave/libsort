DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/libsort
DJANGO_ALLOWED_HOSTS=your-api.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-site.vercel.app
SEED_DEMO_DATA=1
DJANGO_SUPERUSER_USERNAME=libsort_admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-new-strong-password
